{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(uv:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git push origin --delete *)"
    ],
    "deny": [
      "Write(.env)",
      "Edit(.env)"
    ]
  }
}

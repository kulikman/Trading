# Copy to .env and fill in locally. Never commit .env.
# Variables are added here by the task that first uses them (see TASKS.md).

# --- Local Postgres + Redis (docker-compose.yml; defaults are used when empty) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
REDIS_PORT=
# Empty = local docker database built from the values above (see Makefile).
DATABASE_URL=
# Empty = local docker Redis on REDIS_PORT (see Makefile).
REDIS_URL=

# --- Market data (T05) ---
MASSIVE_API_KEY=

# --- Earnings data (T06): free tiers, personal non-commercial use ---
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=                     # Financial Modeling Prep: fallback EPS-консенсус; 250 req/day free tier

# --- SEC EDGAR, FRED, Claude API (T07) ---
# SEC requires a descriptive User-Agent with a contact email, e.g. "Company Name admin@company.com".
SEC_USER_AGENT=
FRED_API_KEY=
ANTHROPIC_API_KEY=

# Дашборд (T19): секрет между web/ и API; длинная случайная строка, например: openssl rand -hex 32
DASHBOARD_API_TOKEN=

# Telegram (T18, запуск 15.10.2026): бот @BotFather и чат заказчика; пусто — сообщения не отправляются
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
